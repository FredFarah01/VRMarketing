# Copy this file to .env and paste your Supabase connection string.
# Supabase dashboard > Connect > "Session pooler" URI (works on IPv4 networks).
# Leave DATABASE_URL empty to use the local SQLite file instead.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string
# CQC Syndication API (Settings > Integrations > CQC). Key from https://api-portal.service.cqc.org.uk > Profile > Subscriptions.
CQC_API_KEY=
CQC_API_BASE_URL=https://api.service.cqc.org.uk/public/v1
# Optional: hours between automatic incremental syncs (0 = off), cap records per job while testing.
CQC_AUTO_SYNC_HOURS=0
CQC_SYNC_LIMIT=
# Optional sales login for CQC prospecting (no access to settings or exports).
SALES_PASSWORD=
