# Copy this file to .env and paste your Supabase connection string.
# Supabase dashboard > Connect > "Session pooler" URI (works on IPv4 networks).
# Leave DATABASE_URL empty to use the local SQLite file instead.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres?sslmode=require
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string
